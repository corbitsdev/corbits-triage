:8080

handle /api/* {
	reverse_proxy {$HUB_UPSTREAM} {
		header_up Host {upstream_hostport}
	}
}

handle {
	root * /srv
	try_files {path} /index.html
	file_server
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https: wss:; form-action https://github.com; frame-ancestors 'none'; base-uri 'self'"
	}
}
