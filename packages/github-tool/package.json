{
  "name": "@corbits/github-tool",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./github": "./src/github.ts"
  },
  "interchange": {
    "tools": "./dist/sidecar-bundle.js",
    "credentials": [
      {
        "handle": "github"
      }
    ]
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "dependencies": {
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "main": "./src/index.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "description": "Read-only GitHub tools"
}
