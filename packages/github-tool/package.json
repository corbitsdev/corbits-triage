{
  "name": "@corbits/github-tool",
  "version": "0.7.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./github": "./src/github.ts",
    "./do": "./src/do.ts"
  },
  "interchange": {
    "tools": "./dist/index.js",
    "credentials": [
      {
        "handle": "github"
      }
    ]
  },
  "scripts": {
    "build": "bun run build.ts",
    "pack:tool": "bun run build.ts pack"
  },
  "dependencies": {
    "@corbits/triage-contracts": "workspace:*",
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "arktype": "catalog:",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tar": "catalog:"
  },
  "main": "./src/index.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "description": "GitHub read and write tools for Interchange"
}
