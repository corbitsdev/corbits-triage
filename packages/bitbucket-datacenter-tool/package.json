{
  "name": "@corbits/bitbucket-datacenter-tool",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./calls": "./src/sidecar-bundle.ts",
    "./bitbucket": "./src/bitbucket.ts",
    "./action": "./src/action.ts"
  },
  "interchange": {
    "tools": "./dist/index.js",
    "credentials": [
      {
        "handle": "bitbucket-datacenter"
      }
    ]
  },
  "scripts": {
    "build": "bun run build.ts",
    "pack:tool": "bun run build.ts pack"
  },
  "dependencies": {
    "@corbits/bitbucket-datacenter-reads": "workspace:*",
    "@corbits/github-reads": "workspace:*",
    "@corbits/repo-read-tool": "workspace:*",
    "@corbits/triage-contracts": "workspace:*",
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "main": "./src/index.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "description": "Bitbucket Data Center read and write tools for Interchange"
}
