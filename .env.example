# Hub. Every variable is validated at startup (apps/hub/src/env.ts).
# Generate a different 32-byte hex value for each secret: `openssl rand -hex 32`.
# Under Docker Compose only these four apply; compose.yml sets the rest.
# No model or judge setting belongs here. A workspace saves a decision model in the portal
# (Settings → Triage). Triage does not start until that model is saved.
BETTER_AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
PRINCIPAL_KEY_ENCRYPTION_KEY=
SIDECAR_CREDENTIAL_ENCRYPTION_KEY=

# Add ?sslmode=require for a database reached over the public internet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interchange
# The URL users open. Locally the Vite proxy presents the hub's own origin.
BETTER_AUTH_BASE_URL=http://localhost:3000
PORT=3000
# Run history, workflow sources and sidecar state. Persistent volume in production.
HUB_DATA_DIR=./tmp/hub-data

# Postgres statement timeout in ms (default 60000).
# DB_STATEMENT_TIMEOUT_MS=

# The hub URL sidecars dial. Unset = ws://127.0.0.1:<PORT>/api/sidecars/ws
# HUB_SIDECAR_WEBSOCKET_URL=

# The origin sidecars reach the hub REST API at, for workflows that call it. Unset = the origin of BETTER_AUTH_BASE_URL
# HUB_API_ORIGIN=

# Milliseconds the local sidecar gets to shut down after SIGTERM before SIGKILL. Default 25000.
# HUB_SIDECAR_STOP_TIMEOUT_MS=

# Deployments the hub's local sidecar runs at once: the listener, one manager per pull request and the judge. Default 16, at most 1792.
# TRIAGE_SIDECAR_MAX_DEPLOYMENTS=

# Docker daemon for workflows that require isolation:workload, registered when it answers
# and holds the image from: docker build --target sidecar -t corbits-triage-sidecar .
# Unset: the docker CLI's context (DOCKER_CONTEXT, else its current one), else
# /var/run/docker.sock or ~/.docker/run/docker.sock. See docs/provisioners/docker.md.
# DOCKER_HOST=
# Mutual TLS, required for a daemon on another machine (docs/provisioners/docker-remote.md).
# Its sidecars dial BETTER_AUTH_BASE_URL (which must be https://) as wss://…/api/sidecars/ws; leave
# HUB_SIDECAR_WEBSOCKET_URL unset so local sidecars keep dialling loopback.
# Set all three or none: ca.pem, cert.pem and key.pem, each as one line of base64 (base64 < ca.pem | tr -d '\n').
# DOCKER_TLS_CA=
# DOCKER_TLS_CERT=
# DOCKER_TLS_KEY=

# E2B for workflows that require isolation:workload, registered when set. Needs the
# corbits-triage-sidecar template and a public https:// hub. See docs/provisioners/e2b.md.
# E2B_API_KEY=

# Milliseconds between passes that re-queue open pull requests whose head is not triaged. Default 300000.
# TRIAGE_RECONCILE_INTERVAL_MS=

# Pull request heads the reconciler lets a tenant have queued or running at once. Default 5.
# TRIAGE_MAX_IN_FLIGHT=
# Milliseconds after a head is capped by runs that never started before it gets a fresh set of attempts. Default 21600000.
# TRIAGE_CAPPED_RETRY_MS=
# Milliseconds without a new webhook event before a pull request's events go out as one triage run; at most four times this after the first. Default 30000.
# TRIAGE_COALESCE_QUIET_MS=

# Interchange settings. Unset keeps the default shown: Interchange's stock default, except
# HUB_MAIL_HOLD_TTL_MS, HUB_MAIL_ACK_RETRY_INTERVAL_MS and HUB_MAIL_ACK_MAX_RETRIES,
# which the hub raises so routed triage mail survives a long pack receive.
# Durations are whole numbers ending in s, m, h or d; the max lifetime and max disconnected
# must be above zero.
# HUB_MAX_TARBALL_BYTES=10485760
# HUB_AGENT_GC_PACK_THRESHOLD=64
# HUB_AGENT_GC_LOOSE_THRESHOLD=2048
# HUB_AGENT_GC_WARN_BYTES=268435456
# HUB_PROBE_TIMEOUT_MS=60000
# HUB_SIDECAR_REQUEST_TIMEOUT_MS=30000
# HUB_MAIL_HOLD_TTL_MS=900000
# HUB_MAIL_ACK_RETRY_INTERVAL_MS=30000
# HUB_MAIL_ACK_MAX_RETRIES=10
# WORKFLOW_DEFAULT_MAX_LIFETIME=7d
# WORKFLOW_DEFAULT_MAX_DISCONNECTED=15m

# GitHub API origin. Unset = https://api.github.com. Local emulator: http://localhost:4000
# GITHUB_API_ORIGIN=

# Optional comma-separated hostnames or IPs of private-network Bitbucket Data
# Center instances. A listed host may resolve to private or loopback addresses;
# every other non-public address stays refused. Unset means none.
# BITBUCKET_EGRESS_ALLOWLIST=

# Sign-in. Google is optional; set both or neither. Redirect URI:
# <BETTER_AUTH_BASE_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional allowlist of exact emails and @domains. Without SMTP it requires
# Google and turns email/password sign-in off. Example: @corbits.dev,friend@example.com
# AUTH_ALLOWED_EMAILS=

# Invite, password reset and address verification emails sent over SMTP; set
# both or neither. Unset, the portal shows each invite's link to copy and send yourself.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=Corbits Triage <triage@example.com>

# Portal hosting. PORTAL_DIR: the hub serves the built portal and publishes the
# workflows it bundles (the image sets it; unset, they come from apps/web/public).
# PORTAL_ORIGIN: a portal on another origin under the same parent domain; invite
# links point there (unset = BETTER_AUTH_BASE_URL).
# PORTAL_DIR=
# PORTAL_ORIGIN=

# Portal (build-time). Unset = the portal reaches the hub on its own origin
# (hub-served, a host rewrite, or the Vite dev proxy).
# VITE_HUB_URL=
# VITE_GITHUB_API_ORIGIN=
