{
  "name": "corbits-triage",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e",
    "vendor/interchange/packages/*",
    "vendor/interchange/apps/*",
    "vendor/interchange/tests/admin-ui-e2e"
  ],
  "catalog": {
    "@types/semver": "^7.7.1",
    "@types/ssri": "^7.1.5",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.44.3",
    "postgres": "^3.4.8",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1"
  },
  "scripts": {
    "dev": "bun --conditions=intx-src tooling/dev.ts",
    "test": "bun --conditions=intx-src test --path-ignore-patterns='**/*.dom.test.tsx' ./apps/ ./packages/ ./tooling/ && bun --conditions=intx-src test --preload ./apps/web/src/lib/dom-preload.ts .dom.test",
    "check": "tsc --noEmit -p tooling && tsc -b apps/web && tsc --noEmit -p apps/extension && tsc --noEmit -p apps/extension/e2e && tsc --noEmit -p apps/hub && tsc --noEmit -p packages/triage-workflows && tsc --noEmit -p packages/pr-code-review && tsc --noEmit -p packages/pr-code-review-anthropic && tsc --noEmit -p packages/pr-workflow-anthropic && tsc --noEmit -p packages/provisioner-test && tsc --noEmit -p packages/provisioner-template && tsc --noEmit -p packages/provisioner-docker && tsc --noEmit -p packages/provisioner-e2b && tsc --noEmit -p packages/provisioner-railway && tsc --noEmit -p packages/policy-check-action && tsc --noEmit -p e2e && bun build --conditions=intx-src apps/hub/src/server.ts --target bun --outfile /dev/null",
    "lint": "oxlint",
    "eval:review": "bun --conditions=intx-src packages/pr-code-review-anthropic/evals/review.eval.ts",
    "holdback": "bun --conditions=intx-src tooling/holdback-replay.ts",
    "report": "bun --conditions=intx-src tooling/cost-latency-report.ts",
    "hub": "bun --conditions=intx-src apps/hub/src/server.ts",
    "vendor:health": "sh tooling/vendor-health-check.sh"
  },
  "devDependencies": {
    "@corbits/evals": "0.1.2",
    "@intx/agent": "workspace:*",
    "@intx/authz": "workspace:*",
    "@intx/harness": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/storage-isogit": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-host": "workspace:*",
    "@types/bun": "1.3.9",
    "oxlint": "^1.87.0",
    "tar": "catalog:",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@corbits/system-one": "0.3.1"
  },
  "overrides": {
    "arktype": "2.2.7"
  }
}
