{
  "name": "corbits-triage",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/interchange/packages/*",
    "vendor/interchange/apps/*",
    "vendor/interchange/tests/admin-ui-e2e"
  ],
  "catalog": {
    "@types/semver": "^7.7.1",
    "@types/ssri": "^7.1.5",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
    "postgres": "^3.4.8",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1"
  },
  "scripts": {
    "dev": "bun --conditions=intx-src tooling/dev.ts",
    "test": "bun --conditions=intx-src test ./apps/ ./packages/ ./tooling/",
    "check": "tsc --noEmit -p tooling && tsc -b apps/web && tsc --noEmit -p apps/hub && bun build --conditions=intx-src apps/hub/src/server.ts --target bun --outfile /dev/null",
    "lint": "oxlint",
    "holdback": "bun --conditions=intx-src tooling/holdback-replay.ts",
    "injection": "bun --conditions=intx-src tooling/injection-run.ts",
    "report": "bun --conditions=intx-src tooling/cost-latency-report.ts",
    "hub": "bun --conditions=intx-src apps/hub/src/server.ts",
    "vendor:health": "sh tooling/vendor-health-check.sh"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@corbits/system-one": "0.3.1",
    "@intx/hub-client": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/types": "workspace:*"
  },
  "overrides": {
    "arktype": "2.2.7"
  }
}
