{
  "name": "@corbits/extension",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Corbits Triage browser extension: checks a GitHub pull request against its repository's policy, on the pull request page.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@corbits/common": "workspace:*",
    "@corbits/github-reads": "workspace:*",
    "@corbits/react-ui": "0.3.1",
    "@corbits/triage-contracts": "workspace:*",
    "@corbits/triage-workflows": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@fontsource-variable/red-hat-display": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@wxt-dev/storage": "1.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "playwright": "1.63.0",
    "vite": "6.4.3",
    "wxt": "0.21.4"
  }
}
